{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/gifts/:id",
      "destination": "/api/gifts/[id]"
    },
    {
      "source": "/api/gifts",
      "destination": "/api/gifts/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
